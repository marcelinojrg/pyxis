generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// BETTER AUTH START
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")
  roleId        String?   @map("role_id")
  accounts      Account[]
  articles      Article[]
  sessions      Session[]

  roles Role[] @relation("RoleToUser")

  @@map("users")
}

model Session {
  id             String   @id @default(uuid())
  expiresAt      DateTime @map("expires_at")
  token          String   @unique
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  impersonatedBy String?  @map("impersonated_by")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  roles       Role[]   @relation("PermissionToRole")

  @@map("permissions")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  permissions Permission[] @relation("PermissionToRole")
  users       User[]       @relation("RoleToUser")

  @@map("roles")
}

// BETTER AUTH END

model EmailQueue {
  id          String      @id @default(cuid())
  to          String
  subject     String
  body        String
  attachments String?
  status      EmailStatus @default(PENDING)
  attempts    Int         @default(0)
  error       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("email_queues")
}

model ArticleCategory {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  articles  Article[]

  @@map("article_categories")
}

model Article {
  id                String            @id @default(uuid())
  title             String
  content           String
  cover             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  createdById       String?           @map("created_by_id")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  slug              String?           @unique
  articleCategories ArticleCategory[]
  createdBy         User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("articles")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String
  phone     String
  email     String
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branches")
}

model Client {
  id        String   @id @default(uuid())
  name      String
  image     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clients")
}

model Product {
  id              String              @id @default(uuid())
  slug            String              @unique
  name            String
  description     String?
  image           String?             @map("image") // Gambar di Hero Section kanan
  featureSubtitle String?             @map("feature_subtitle") // Subtitle "Fitur Utama"
  benefits        ProductBenefit[]
  features        ProductFeature[]
  capabilities    ProductCapability[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("products")
}

model ProductBenefit {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  title       String
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_benefits")
}

model ProductFeature {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  title       String
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_features")
}

model ProductCapability {
  id          String                  @id @default(cuid())
  productId   String                  @map("product_id")
  title       String                  @default("System Capabilities")
  description String?
  imageUrl    String?                 @map("image_url") // Gambar mockup di sisi kiri section
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  items       ProductCapabilityItem[]

  @@index([productId])
  @@map("product_capabilities")
}

model ProductCapabilityItem {
  id                  String            @id @default(cuid())
  productCapabilityId String            @map("product_capability_id")
  title               String
  description         String?
  icon                String?
  order               Int               @default(0)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  capability          ProductCapability @relation(fields: [productCapabilityId], references: [id], onDelete: Cascade)

  @@index([productCapabilityId])
  @@map("product_capability_items")
}

model CareerCategory {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  careers   Career[]

  @@map("career_categories")
}

model Career {
  id               String              @id @default(uuid())
  categoryId       String?             @map("category_id")
  title            String
  slug             String              @unique
  location         String // contoh: "Malang, Indonesia / Remote"
  type             String // contoh: "Full-time", "Contract", "Part-time"
  department       String? // contoh: "Engineering", "Design", dll
  description      String // Section "Tentang Peran Ini"
  responsibilities String[] // Section "Tanggung Jawab Utama" (List)
  requirements     String[] // Section "Persyaratan" (List)
  isActive         Boolean             @default(true) @map("is_active")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  category         CareerCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  applications     CareerApplication[]

  @@index([categoryId])
  @@map("careers")
}

model CareerApplication {
  id           String            @id @default(cuid())
  careerId     String            @map("career_id")
  fullName     String            @map("full_name")
  email        String
  phone        String
  portfolioUrl String?           @map("portfolio_url") // LinkedIn / Portfolio
  resumeUrl    String            @map("resume_url") // File CV / Resume yang diunggah
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  career       Career            @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@index([careerId])
  @@map("career_applications")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletter_subscribers")
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  INTERVIEW
  ACCEPTED
  REJECTED
}
